# Postgres dedicado do email-checker (docker: email-checker-postgres, porta 5435).
EMAIL_CHECKER_DATABASE_URL="postgresql://postgres:postgres@localhost:5435/email_checker"

# Segredo para assinar as sessões (cookie). Gere com: openssl rand -hex 32
AUTH_SECRET="troque-me-com-openssl-rand-hex-32"

# Créditos concedidos no cadastro de um novo usuário.
SIGNUP_BONUS_CREDITS="500"

# Caminho da lista de domínios descartáveis (default: ./data/disposable-domains.txt).
# Em produção (Docker), aponte para o caminho absoluto dentro da imagem.
# DISPOSABLE_DOMAINS_PATH="/app/apps/email-checker/data/disposable-domains.txt"
