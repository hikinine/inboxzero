// Catálogo de telas (SVG) — modelagem enxuta e indexada para escala (centenas de milhares).
// Migrations do monorepo são problemáticas (shadow DB); use `prisma db push`.

generator client {
  provider      = "prisma-client-js"
  // "native" p/ dev local; "debian-openssl-3.0.x" p/ a imagem de produção (node:22-bookworm-slim).
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("CATALOG_DATABASE_URL")
}

enum ScreenStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// Agrupa telas por app/projeto/família.
model Collection {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  screens     Screen[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("collections")
}

// Uma tela do catálogo. O SVG é guardado inline (coluna text) — simples de servir via MCP.
model Screen {
  id           String       @id @default(cuid())
  slug         String       @unique
  name         String
  description  String?
  svg          String       // markup SVG completo
  width        Int?
  height       Int?
  status       ScreenStatus @default(PUBLISHED)
  source       String       @default("manual") // origem: manual | mcp | generated | import
  collectionId String?
  collection   Collection?  @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  tags         ScreenTag[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([collectionId])
  @@index([status])
  @@index([createdAt])
  @@index([name])
  @@map("screens")
}

model Tag {
  id      String      @id @default(cuid())
  slug    String      @unique
  name    String
  screens ScreenTag[]

  @@map("tags")
}

// Junction N:N Screen↔Tag.
model ScreenTag {
  screenId String
  tagId    String
  screen   Screen @relation(fields: [screenId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([screenId, tagId])
  @@index([tagId])
  @@map("screen_tags")
}
