# Postgres (database + role próprios no main database do Dokploy)
ARQUITETURA_DATABASE_URL=postgresql://arquitetura:senha@localhost:5432/arquitetura
# Senha única de acesso ao app e segredo do cookie de sessão
APP_PASSWORD=
AUTH_SECRET=
# Chave da Anthropic (o chat usa claude-opus-5-5 por padrão)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_FALLBACKS=off   # desliga o modelo reserva em caso de recusa
