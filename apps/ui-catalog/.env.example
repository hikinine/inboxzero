# Postgres dedicado do catálogo de UI (docker: infra/docker-compose.yml → ui-catalog-postgres, porta 5436).
UI_CATALOG_DATABASE_URL="postgresql://postgres:postgres@localhost:5436/ui_catalog"

# Token Bearer do endpoint MCP (POST /api/mcp). Gere com: openssl rand -hex 32
UI_CATALOG_MCP_TOKEN="troque-me"

# URL pública (usada no registry e nos comandos de instalação exibidos na UI).
NEXT_PUBLIC_SITE_URL="http://localhost:3073"
